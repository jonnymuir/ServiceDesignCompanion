@inherits UmbracoViewPage
@{
    Layout = "Shared/Master.cshtml";
    var number = Model.Value<int>(SiteContentTypes.PointNumber);
    var summary = Model.Value<string>(SiteContentTypes.Summary);
    var explainer = Model.Value<Umbraco.Cms.Core.Strings.IHtmlEncodedString>(SiteContentTypes.Explainer)?.ToHtmlString();
    var questions = (Model.Value<string>(SiteContentTypes.Questions) ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var siblings = Model.Parent<IPublishedContent>()?.Children().ToList() ?? [];
    var index = siblings.FindIndex(p => p.Id == Model.Id);
    var previous = index > 0 ? siblings[index - 1] : null;
    var next = index >= 0 && index < siblings.Count - 1 ? siblings[index + 1] : null;
}
<span class="govuk-caption-l">Point @number of @siblings.Count</span>
<h1 class="govuk-heading-xl">@Model.Name</h1>

@if (!string.IsNullOrWhiteSpace(summary))
{
    <p class="govuk-body-l">@summary</p>
}

@if (!string.IsNullOrWhiteSpace(explainer))
{
    <div class="govuk-body psd-prose">@Html.Raw(explainer)</div>
}
else
{
    <p class="govuk-body">Our plain-words guide to this point is on its way. Until then, the full guidance is on GOV.UK.</p>
}

@if (questions.Length > 0)
{
    <div class="psd-questions">
        <h2 class="govuk-heading-m">Questions to think about</h2>
        <ul class="govuk-list govuk-list--bullet">
            @foreach (var question in questions)
            {
                <li>@question</li>
            }
        </ul>
    </div>
}

<p class="govuk-body"><a class="govuk-link" href="@Model.Value(SiteContentTypes.GuidanceUrl)">Read the full guidance for point @number on GOV.UK</a></p>

<nav class="govuk-pagination govuk-pagination--block" aria-label="Points">
    @if (previous is not null)
    {
        <div class="govuk-pagination__prev">
            <a class="govuk-link govuk-pagination__link" href="@previous.Url()" rel="prev">
                <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path></svg>
                <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> point</span></span>
                <span class="govuk-visually-hidden">:</span>
                <span class="govuk-pagination__link-label">@previous.Name</span>
            </a>
        </div>
    }
    @if (next is not null)
    {
        <div class="govuk-pagination__next">
            <a class="govuk-link govuk-pagination__link" href="@next.Url()" rel="next">
                <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path></svg>
                <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> point</span></span>
                <span class="govuk-visually-hidden">:</span>
                <span class="govuk-pagination__link-label">@next.Name</span>
            </a>
        </div>
    }
</nav>